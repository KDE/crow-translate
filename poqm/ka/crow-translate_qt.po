#: src/cli.cpp:78
msgctxt "Cli|"
msgid "translation options:"
msgstr "თარგმანის მორგება:"

#: src/cli.cpp:87
msgctxt "Cli|"
msgid "examples:"
msgstr "მაგალითები:"

#: src/cli.cpp:118
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "ყველა ენის კოდის ჩვენება."

#: src/cli.cpp:120
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr ""
"მიუთითეთ წყარო ენა (ნაგულისხმევად ძრავა ენის დადგენას თვითონ შეეცდება)."

#: src/cli.cpp:124
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr ""
"მიუთითეთ სათარგმნი ენები, '+'-ით გამოყოფილი (ნაგულისხმევად გამოიყენება "
"სისტემის ენა)."

#: src/cli.cpp:129
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'deepl', "
"'libretranslate', 'mymemory' or 'reverso'), Google is used by default."
msgstr ""
"მიუთითეთ მთარგმნელი ძრავა ('google', 'yandex', 'bing', 'libretranslate' ან "
"'mymemory', ან 'reverso'). ნაგულისხმევად გამოიყენება Google."

#: src/cli.cpp:133
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"მიუთითეთ Mozhi-ის გაშვებული ასლის ბმული. ნაგულისხმევად გამოყენებული იქნება "
"ბმული აპის პარამეტრებიდან."

#: src/cli.cpp:137
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy', 'mozhi' or 'localai'). Provider from "
"app settings will be used by default."
msgstr ""
"მიუთითეთ თარგმანის მომწოდებელი ('copy', 'mozhi', ან 'localai'). "
"ნაგულისხმევად გამოყენებული იქნება მომწოდებელი აპის პარამეტრებიდან."

#: src/cli.cpp:145
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt' or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"მიუთითეთ TTS-ის მომწოდებელი ('none', 'mozhi', 'qt', ან 'piper'). "
"ნაგულისხმევად გამოყენებული იქნება მომწოდებელი აპის პარამეტრებიდან."

#: src/cli.cpp:147
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi' or 'qt'). Provider from app settings "
"will be used by default."
msgstr ""
"მიუთითეთ TTS-ის მომწოდებელი ('none', 'mozhi', ან 'qt'). ნაგულისხმევად "
"გამოყენებული იქნება მომწოდებელი აპის პარამეტრებიდან."

#: src/cli.cpp:149
msgctxt "Cli|"
msgid "Specify TTS provider ('none'). This build has text-to-speech disabled."
msgstr ""
"მიუთითეთ TTS-ის მომწოდებელი ('არცერთი'). ამ აგებაში ტექსტის წარმოთქმა "
"გამორთულია."

#: src/cli.cpp:152
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "თარგმანის წარმოთქმა."

#: src/cli.cpp:153
msgctxt "Cli|"
msgid "Speak the source."
msgstr "წყაროს წარმოთქმა."

#: src/cli.cpp:154
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr ""
"წყარო ტექსტის ფაილებიდან წაკითხვა. არგუმენტები აღქმული იქნება, როგორც ფაილის "
"ბილიკები."

#: src/cli.cpp:155
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "სტანდარტული შეყვანის მონაცემების დამატება წყარო ტექსტზე."

#: src/cli.cpp:157
msgctxt "Cli|"
msgid "Read source text from an image using the configured OCR engine."
msgstr ""
"წყარო ტექსტის წაკითხვა გამოსახულებიდან მორგებული OCR ძრავის გამოყენებით."

#: src/cli.cpp:158
msgctxt "Cli|"
msgid "path"
msgstr "ბილიკი"

#: src/cli.cpp:160
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "არ გამოიტანო ტექსტი, როცა გამოყენებულია პარამეტრები --%1 ან --%2."

#: src/cli.cpp:161
msgctxt "Cli|"
msgid "Print only translations."
msgstr "მხოლოდ თარგმანების გამოტანა."

#: src/cli.cpp:162
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "გამოტანა JSON ფორმატში."

#: src/cli.cpp:168
msgctxt "Cli|"
msgid ""
"Which frontend to run ('gui' or 'cli'). Defaults to 'cli' whenever any "
"argument is given."
msgstr ""
"რომელი წინაბოლო გაეშვება ('gui', თუ 'cli'). თუ მითითებულია ნებისმიერი სხვა "
"არგუმენტი, ნაგულისხმევად გამოიყენება 'cli'."

#: src/cli.cpp:169
msgctxt "Cli|"
msgid "frontend"
msgstr "წინაბოლო"

#: src/cli.cpp:173
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr ""
"აპლიკაცია, რომელიც საშუალებას გაძლევთ, თარგმნოთ და წარმოთქვათ ტექსტი "
"სხვადასხვა მომწოდებლების გამოყენებით"

#: src/cli.cpp:174
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
