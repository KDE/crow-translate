#: src/tts/piperttsprovider.cpp:1395
msgctxt "PiperTTSProvider|"
msgid ""
"<h3>Piper Voice Models Not Found</h3><p>No Piper TTS voice models were found "
"in the standard locations.</p><p><b>To use Piper TTS:</b></"
"p><ol><li>Download voice models from <a href='https://huggingface.co/rhasspy/"
"piper-voices'>HuggingFace Piper Voices</a></li><li>Extract the models to a "
"directory</li><li>Set the path in Settings → TTS → Piper Voices Path</li></"
"ol><p><b>⚠️ License Warning:</b> Some models may have non-free licenses and "
"cannot be used in commercial settings. Please check the license of each "
"model before commercial use.</p>"
msgstr ""
"<h3>Не знайдено моделей дикторів Piper</h3><p>У стандартних місцях не "
"знайдено даних моделей дикторів системи озвучення тексту Piper.</p><p><b>Щоб "
"скористатися системою озвучення тексту Piper:</b></p><ol><li>Отримайте "
"моделі дикторів зі <a href='https://huggingface.co/rhasspy/piper-"
"voices'>сторінки дикторів HuggingFace Piper</a></li><li>Розпакуйте моделі до "
"каталогу</li><li>Встановіть шлях за допомогою пункту «Параметри → Озвучення "
"тексту → Шлях до дикторів Piper</li></ol><p><b>⚠️ Попередження щодо "
"ліцензування:</b> Умови ліцензування деяких моделей не є вільними — їх не "
"можна використовувати з комерційною метою. Будь ласка, ознайомтеся з умовами "
"ліцензування кожної з моделей, перш ніж використовувати її з комерційною "
"метою.</p>"

#: src/tts/piperttsprovider.cpp:1407
msgctxt "PiperTTSProvider|"
msgid "Piper Voice Models Required"
msgstr "Потрібні моделі дикторів Piper"

#: src/tts/qtttsprovider.cpp:329
#, qt-format
msgctxt "QtTTSProvider|"
msgid ""
"<h3>Windows TTS Voice Not Found</h3><p>No Windows TTS voice was found for <b>"
"%1</b>.</p><p><b>To install additional languages:</b></p><ol><li>Open "
"<b>Settings → Time & Language → Language & region</b></li><li>Click <b>Add a "
"language</b> and select your desired language</li><li>Click on the installed "
"language and select <b>Language options</b></li><li>Under <b>Speech</b>, "
"click <b>Download</b> for the speech pack</li></ol><p><b>⚠️ License Note:</b> "
"Crow Translate currently only supports \"Basic voice models\" from Windows "
"TTS. \"Narrator voices\" have licensing restrictions that are incompatible "
"with this application.</p>"
msgstr ""
"<h3>Не знайдено диктора озвучення тексту Windows</h3><p>Не знайдено диктора "
"озвучення тексту Windows для мови <b>%1</b>.</p><p><b>Для встановлення даних "
"додаткових мов:</b></p><ol><li>Перейдіть на сторінку <b>Параметри → Час і "
"мова → Мова і регіон</b></li><li>Натисніть <b>Додати мову</b> і виберіть "
"бажану мову</li><li>Натисніть пункт встановленої мови і виберіть "
"<b>Параметри мови</b></li><li>У розділі <b>Озвучення</b> виберіть пункт "
"<b>Отримати</b> для пакунка озвучення</li></ol><p><b>⚠️ Зауваження щодо "
"ліцензування:</b> У поточній версії Crow Translate передбачено підтримку "
"лише «Базових моделей дикторів» з системи озвучення тексту Windows. «Голоси "
"диктора» мають ліцензійні обмеження, які є несумісними з цією програмою.</p>"

