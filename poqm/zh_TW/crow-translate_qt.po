#: src/cli.cpp:37
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "顯示所有語言代碼。"

#: src/cli.cpp:39
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr "指定原文語言（不指定時引擎預設會自行嘗試判斷語言）。"

#: src/cli.cpp:43
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr "指定翻譯語言，以 '+' 分隔（不指定時預設會使用系統語言）。"

#: src/cli.cpp:47
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'libretranslate' "
"or 'lingva'), Google is used by default."
msgstr ""
"指定翻譯引擎（'google'、'yandex'、'bing'、'libretranslate' 或 'lingva'），預"
"設使用 Google。"

#: src/cli.cpp:51
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr "指定 Mozhi 實體網址。預設會使用應用程式設定裡指定的實體網址。"

#: src/cli.cpp:55
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy' or 'mozhi'). Provider from app settings "
"will be used by default."
msgstr ""
"指定翻譯提供者（'copy' 或 'mozhi'）。預設會使用應用程式設定裡指定的提供者。"

#: src/cli.cpp:58
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt', or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"指定 TTS 提供者（'none'、'mozhi'、'qt' 或 'piper'）。預設會使用應用程式設定裡"
"指定的提供者。"

#: src/cli.cpp:60
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "朗讀譯文。"

#: src/cli.cpp:61
msgctxt "Cli|"
msgid "Speak the source."
msgstr "朗讀原文。"

#: src/cli.cpp:62
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr "從檔案讀取原文。參數將被視為檔案路徑。"

#: src/cli.cpp:63
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "將標準輸入文字加入原文。"

#: src/cli.cpp:65
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "當使用 --%1 或 --%2 時不輸出任何文字。"

#: src/cli.cpp:66
msgctxt "Cli|"
msgid "Print only translations."
msgstr "只輸出翻譯。"

#: src/cli.cpp:67
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "將結果輸出為 JSON 格式。"

#: src/cli.cpp:70
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr "讓您利用各種提供者進行文字翻譯與朗讀的應用程式"

#: src/cli.cpp:71
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
"language."
