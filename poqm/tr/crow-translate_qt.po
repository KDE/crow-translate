#: src/cli.cpp:37
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "Tüm dil kodlarını görüntüle."

#: src/cli.cpp:39
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr "Kaynak dili belirt (Öntanımlı: Kendiliğinden algılama)."

#: src/cli.cpp:43
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr "Çeviri dillerini “+” ile ayırıp belirt (Öntanımlı: Sistem dili)."

#: src/cli.cpp:47
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'libretranslate' "
"or 'lingva'), Google is used by default."
msgstr ""
"Çeviri işletkesini belirt (“google”, “yandex”, “bing”, “libretranslate”\n"
"veya “lingva”). Öntanımlı olarak Google kullanılır."

#: src/cli.cpp:51
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"Mozhi örneği URL’sini belirtin. Öntanımlı olarak, uygulama ayarlarındaki "
"örnek URL’si kullanılır."

#: src/cli.cpp:55
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy' or 'mozhi'). Provider from app settings "
"will be used by default."
msgstr ""
"Çeviri sağlayıcısını belirtin (“copy” veya “mozhi”). Öntanımlı olarak "
"uygulama ayarlarındaki sağlayıcı kullanılır."

#: src/cli.cpp:58
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt', or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"Metin Konuşma sağlayıcısını belirtin (“none”, “mozhi”, “qt” veya “piper”). "
"Öntanımlı olarak uygulama ayarlarındaki sağlayıcı kullanılır."

#: src/cli.cpp:60
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "Çeviriyi konuş."

#: src/cli.cpp:61
msgctxt "Cli|"
msgid "Speak the source."
msgstr "Kaynağı konuş."

#: src/cli.cpp:62
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr "Kaynak metni dosyadan oku. Argümanlar, dosya yolu olarak yorumlanır."

#: src/cli.cpp:63
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "Kaynak metne stdin verisini ekle."

#: src/cli.cpp:65
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "--%1 veya --%2 kullanırken herhangi bir metin yazdırma."

#: src/cli.cpp:66
msgctxt "Cli|"
msgid "Print only translations."
msgstr "Yalnızca çevirileri yazdır."

#: src/cli.cpp:67
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "Çıktıyı JSON olarak biçimlendir."

#: src/cli.cpp:70
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr ""
"Çeşitli sağlayıcıları kullanarak çeviri yapmak ve metin konuşmak için bir "
"uygulama"

#: src/cli.cpp:71
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
