#: src/cli.cpp:37
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "Mostra tots els codis d'idioma."

#: src/cli.cpp:39
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr ""
"Especifiqueu l'idioma d'origen (de manera predeterminada, el motor intentarà "
"determinar l'idioma per si mateix)."

#: src/cli.cpp:43
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr ""
"Especifica els idiomes de traducció, separats per «+» (de manera "
"predeterminada, s'utilitza l'idioma del sistema)."

#: src/cli.cpp:47
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'libretranslate' "
"or 'lingva'), Google is used by default."
msgstr ""
"Especifica el motor del traductor («google», «yandex», «bing», "
"«libretranslate» o «lingva»), s'utilitza Google de manera predeterminada."

#: src/cli.cpp:51
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"Especifica l'URL de la instància de Mozhi. De manera predeterminada "
"s'utilitzarà l'URL de la instància a la configuració de l'aplicació."

#: src/cli.cpp:55
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy' or 'mozhi'). Provider from app settings "
"will be used by default."
msgstr ""
"Especifica el proveïdor de traducció («copy» o «mozhi»). De manera "
"predeterminada s'utilitzarà el proveïdor a partir de la configuració de "
"l'aplicació."

#: src/cli.cpp:58
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt', or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"Especifica el proveïdor de TTS («cap», «mozhi», «qt» o «piper»). De manera "
"predeterminada s'utilitzarà el proveïdor a partir de la configuració de "
"l'aplicació."

#: src/cli.cpp:60
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "Llig la traducció."

#: src/cli.cpp:61
msgctxt "Cli|"
msgid "Speak the source."
msgstr "Llig l'origen."

#: src/cli.cpp:62
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr ""
"Llig el text d'origen a partir de fitxers. Els arguments s'interpretaran com "
"a camins de fitxer."

#: src/cli.cpp:63
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "Afig les dades de «stdin» al text d'origen."

#: src/cli.cpp:65
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "No imprimix cap text quan s'utilitza --%1 o --%2."

#: src/cli.cpp:66
msgctxt "Cli|"
msgid "Print only translations."
msgstr "Imprimix només les traduccions."

#: src/cli.cpp:67
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "Imprimix l'eixida amb format JSON."

#: src/cli.cpp:70
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr ""
"Una aplicació que permet traduir i llegir text utilitzant diversos proveïdors"

#: src/cli.cpp:71
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
"language."
msgstr ""
"Text a traduir. De manera predeterminada, la traducció es farà a l'idioma "
"del sistema."

