#: src/cli.cpp:37
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "Mostra todos os códigos de idioma."

#: src/cli.cpp:39
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr ""
"Especifica o idioma de origem (por padrão, o mecanismo tentará determinar o "
"idioma por conta própria)."

#: src/cli.cpp:43
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr ""
"Especifica o(s) idioma(s) de tradução, separados por '+' (por padrão, o "
"idioma do sistema é usado)."

#: src/cli.cpp:47
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'libretranslate' "
"or 'lingva'), Google is used by default."
msgstr ""
"Especificar o mecanismo de tradução ('google', 'yandex', 'bing', "
"'libretranslate' ou 'lingva'), Google é usado por padrão."

#: src/cli.cpp:51
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"Especificar a URL da instância do Mozhi. A URL da instância das "
"configurações do aplicativo será usada por padrão."

#: src/cli.cpp:55
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy' or 'mozhi'). Provider from app settings "
"will be used by default."
msgstr ""
"Especificar o provedor de tradução ('copy' ou 'mozhi'). O provedor nas "
"configurações do aplicativo será usado por padrão."

#: src/cli.cpp:58
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt', or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"Especificar o provedor TTS ('none', 'mozhi', 'qt' ou 'piper'). O provedor "
"das configurações do aplicativo será usado por padrão."

#: src/cli.cpp:60
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "Fala a tradução."

#: src/cli.cpp:61
msgctxt "Cli|"
msgid "Speak the source."
msgstr "Fala o texto original."

#: src/cli.cpp:62
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr ""
"Lê o texto original em arquivos. Argumentos serão interpretados como "
"caminhos de arquivo."

#: src/cli.cpp:63
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "Adiciona dados do stdin para o texto de origem."

#: src/cli.cpp:65
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "Não imprimir nenhum texto quando estiver usando --%1 ou --%2."

#: src/cli.cpp:66
msgctxt "Cli|"
msgid "Print only translations."
msgstr "Imprimir apenas traduções."

#: src/cli.cpp:67
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "Imprimir saída formatada como JSON."

#: src/cli.cpp:70
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr ""
"Aplicativo que permite traduzir e falar textos utilizando diversos provedores"

#: src/cli.cpp:71
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
"language."
msgstr ""
"Texto para traduzir. Por padrão, a tradução será feita no idioma do sistema."

