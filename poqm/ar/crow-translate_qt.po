#: src/cli.cpp:37
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "اعرض جميع رموز اللغات."

#: src/cli.cpp:39
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr "حدد اللغة المصدر (بشكل مبدئي، سيحاول المحرك تحديد اللغة بمفرده)."

#: src/cli.cpp:43
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr "حدد لغة لغات الترجمة مقسمة بـ '+' (ستستخدم لغة النظام مبدئيًا)."

#: src/cli.cpp:47
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'libretranslate' "
"or 'lingva'), Google is used by default."
msgstr ""
"حدد محرك المترجم ('google', 'yandex', 'bing', 'libretransl' أو 'lingva')، "
"سيستخدم غوغل بشكل مبدئي."

#: src/cli.cpp:51
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"حدد عنوان الرابط الخاص بنسخة Mozhi. سيُستخدم رابط النسخة من إعدادات التطبيق "
"بشكل مبدئي."

#: src/cli.cpp:55
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy' or 'mozhi'). Provider from app settings "
"will be used by default."
msgstr ""
"حدد مزود الترجمة ('copy' أو 'mozhi'). سيُستخدم مزود الإعدادات الخاص بالتطبيق "
"بشكل مبدئي."

#: src/cli.cpp:58
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt', or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"حدد مزود تحويل النص إلى كلام ('none' أو 'mozhi' أو 'qt' أو 'piper'). سيُستخدم "
"مزود الإعدادات الخاص بالتطبيق بشكل مبدئي."

#: src/cli.cpp:60
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "انطق الترجمة."

#: src/cli.cpp:61
msgctxt "Cli|"
msgid "Speak the source."
msgstr "انطق المصدر."

#: src/cli.cpp:62
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr "اقرأ نص المصدر من الملفات. ستفسر المعاملات على أنها مسارات ملفات."

#: src/cli.cpp:63
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "إضافة بيانات stdin إلى النص المصدر."

#: src/cli.cpp:65
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "لا تطبع أي نص عند استخدام  --%1 أو --%2."

#: src/cli.cpp:66
msgctxt "Cli|"
msgid "Print only translations."
msgstr "طباعة الترجمات فقط."

#: src/cli.cpp:67
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "إخراج الطباعة بتنسيق JSON."

#: src/cli.cpp:70
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr "تطبيق يسمح بترجمة النصوص والتحدث بها باستخدام عدة مزودات"

#: src/cli.cpp:71
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
"language."
msgstr "نص للترجمة. بشكل مبدئي. مبدئيًّا سيترجم إلى لغة النظام."

