#: src/tts/piperttsprovider.cpp:1395
msgctxt "PiperTTSProvider|"
msgid ""
"<h3>Piper Voice Models Not Found</h3><p>No Piper TTS voice models were found "
"in the standard locations.</p><p><b>To use Piper TTS:</b></"
"p><ol><li>Download voice models from <a href='https://huggingface.co/rhasspy/"
"piper-voices'>HuggingFace Piper Voices</a></li><li>Extract the models to a "
"directory</li><li>Set the path in Settings → TTS → Piper Voices Path</li></"
"ol><p><b>⚠️ License Warning:</b> Some models may have non-free licenses and "
"cannot be used in commercial settings. Please check the license of each "
"model before commercial use.</p>"
msgstr ""
"<h3>Piper Voice modellen niet gevonden</h3><p>Geen Piper TTS voice modellen "
"op de standaard locaties gevonden.</p><p><b>Om Piper TTS te gebruiken:</b></"
"p><ol><li>Download de voice-modellen uit <a href='https://huggingface.co/"
"rhasspy/piper-voices'>HuggingFace Piper Voices</a></li><li>Extraheer de "
"modellen naar een map</li><li>Zet het pad in Instellingen → TTS → Piper "
"Voices pad</li></ol><p><b>⚠️ Licentie waarschuwing:</b> Sommige modellen "
"kunnen niet-vrije licenties hebben en kunnen niet gebruikt worden in "
"commerciële settings. Controleer de licentie van elk model voor commercieel "
"gebruik.</p>"

#: src/tts/piperttsprovider.cpp:1407
msgctxt "PiperTTSProvider|"
msgid "Piper Voice Models Required"
msgstr "Piper stemmodellen vereist"

#: src/tts/qtttsprovider.cpp:329
#, qt-format
msgctxt "QtTTSProvider|"
msgid ""
"<h3>Windows TTS Voice Not Found</h3><p>No Windows TTS voice was found for <b>"
"%1</b>.</p><p><b>To install additional languages:</b></p><ol><li>Open "
"<b>Settings → Time & Language → Language & region</b></li><li>Click <b>Add a "
"language</b> and select your desired language</li><li>Click on the installed "
"language and select <b>Language options</b></li><li>Under <b>Speech</b>, "
"click <b>Download</b> for the speech pack</li></ol><p><b>⚠️ License Note:</b> "
"Crow Translate currently only supports \"Basic voice models\" from Windows "
"TTS. \"Narrator voices\" have licensing restrictions that are incompatible "
"with this application.</p>"
msgstr ""
"<h3>Windows TTS Voice niet gevonden</h3><p>Geen Windows TTS voice is "
"gevonden voor <b>%1</b>.</p><p><b>Om extra talen te installeren:</b></"
"p><ol><li>Open <b>Instellingen → Tijd & Taal → Taal & regio</b></li><li>Klik "
"<b>Voeg een taal toe</b> en selecteer uw gewenste taal</li><li>Klik op de "
"geïnstalleerde taal en selecteer <b>Taalopties</b></li><li>Onder <b>Spraak</"
"b>, klik <b>Download</b> voor het spraakpakket</li></ol><p><b>⚠️ "
"Licentienotitie:</b> Crow Translate ondersteunt nu alleen \"Basis voice-"
"modellen\" uit Windows TTS. \"Narrator voices\" hebben licentiebeperkingen "
"die niet compatibel zijn met deze toepassing.</p>"

