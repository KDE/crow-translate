#: src/cli.cpp:98
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "Toon alle taalcodes."

#: src/cli.cpp:100
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr ""
"Geef de brontaal op (standaard probeert de vertaalmachine deze automatisch "
"te bepalen)."

#: src/cli.cpp:104
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr ""
"Geef de doeltaal/-talen op, gescheiden door '+' (standaard wordt de "
"systeemtaal gebruikt)."

#: src/cli.cpp:109
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'deepl', "
"'libretranslate', 'mymemory' or 'reverso'), Google is used by default."
msgstr ""
"Kies de vertaalmachine ('google', 'yandex', 'bing', 'deepl', "
"'libretranslate', 'mymemory' of 'reverso'). Standaard: Google."

#: src/cli.cpp:113
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr ""
"URL van Mohzi-exemplaar specificeren. URL-exemplaar van de instelling van de "
"toepassing zal standaard gebruikt worden."

#: src/cli.cpp:117
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy', 'mozhi' or 'localai'). Provider from "
"app settings will be used by default."
msgstr ""
"Specificeer leverancier van vertaling ('copy', 'mozhi' of 'localai'). "
"Leverancier van de instellingen van de toepassing zal standaard gebruikt "
"worden."

#: src/cli.cpp:125
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt' or 'piper'). Provider from app "
"settings will be used by default."
msgstr ""
"Specificeer TTS-leverancier ('geen', 'mozhi', 'qt' of 'piper'). Leverancier "
"van de instellingen van de toepassing zal standaard gebruikt worden."

#: src/cli.cpp:127
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi' or 'qt'). Provider from app settings "
"will be used by default."
msgstr ""
"Specificeer TTS-leverancier ('geen', 'mozhi' of 'qt'). Leverancier van de "
"instellingen van de toepassing zal standaard gebruikt worden."

#: src/cli.cpp:129
msgctxt "Cli|"
msgid "Specify TTS provider ('none'). This build has text-to-speech disabled."
msgstr ""
"Specificeer TTS leverancier ('none'). Dit exemplaar heeft tekst-naar-spraak "
"uitgeschakeld."

#: src/cli.cpp:132
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "Lees de vertaling voor."

#: src/cli.cpp:133
msgctxt "Cli|"
msgid "Speak the source."
msgstr "Lees de brontekst voor."

#: src/cli.cpp:134
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr ""
"Lees de brontekst uit uit bestanden. Aanvullende opties worden opgevat als "
"bestandspaden."

#: src/cli.cpp:135
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "Voeg stdin-data toe aan de brontekst."

#: src/cli.cpp:137
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "Toon geen tekst bij gebruik van --%1 of --%2."

#: src/cli.cpp:138
msgctxt "Cli|"
msgid "Print only translations."
msgstr "Toon alleen vertalingen."

#: src/cli.cpp:139
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "Toon geen met json opgemaakte tekst."

#: src/cli.cpp:142
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr ""
"Toepassingen die toestaan tekst te vertalen en uit te spreken gebruiken "
"verschillende leveranciers"

#: src/cli.cpp:143
msgctxt "Cli|"
msgid ""
"Text to translate. By default, the translation will be done to the system "
