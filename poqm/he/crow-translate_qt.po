#: src/cli.cpp:37
msgctxt "Cli|"
msgid "Display all language codes."
msgstr "הצגת הקודים של כל השפות."

#: src/cli.cpp:39
msgctxt "Cli|"
msgid ""
"Specify the source language (by default, engine will try to determine the "
"language on its own)."
msgstr "נא לציין את שפת המקור (כברירת המחדל, המנוע ינסה לזהות את השפה בעצמו)."

#: src/cli.cpp:43
msgctxt "Cli|"
msgid ""
"Specify the translation language(s), split by '+' (by default, the system "
"language is used)."
msgstr ""
"נא לציין את שפות התרגום, יש לפצל ביניהן עם ‚+’ (כברירת מחדל, נעשה שימוש בשפת "
"המערכת)."

#: src/cli.cpp:47
msgctxt "Cli|"
msgid ""
"Specify the translator engine ('google', 'yandex', 'bing', 'libretranslate' "
"or 'lingva'), Google is used by default."
msgstr ""
"בחירת מנוע התרגום (‚google’,‏ ‚yandex’,‏ ‚bing’,‏ ‚libretranslate’ או "
"‚lingva’),‏ Google הוא מנוע ברירת המחדל."

#: src/cli.cpp:51
msgctxt "Cli|"
msgid ""
"Specify Mozhi instance URL. Instance URL from the app settings will be used "
"by default."
msgstr "ציון כתובת עותק Mozhi. ברירת המחדל היא הכתובת המופיעה בהגדרות היישום."

#: src/cli.cpp:55
msgctxt "Cli|"
msgid ""
"Specify translation provider ('copy' or 'mozhi'). Provider from app settings "
"will be used by default."
msgstr ""
"בחירת ספק התרגום (‚copy’ או ‚mozhi’). ברירת המחדל היא הספק מהגדרות היישום."

#: src/cli.cpp:58
msgctxt "Cli|"
msgid ""
"Specify TTS provider ('none', 'mozhi', 'qt', or 'piper'). Provider from app "
"settings will be used by default."
msgstr "בחירת ספק הקראה (‚none’,‏ ‚mozhi’,‏ ‚qt’, או ‚piper’)"

#: src/cli.cpp:60
msgctxt "Cli|"
msgid "Speak the translation."
msgstr "הקראת התרגום."

#: src/cli.cpp:61
msgctxt "Cli|"
msgid "Speak the source."
msgstr "הקראת המקור."

#: src/cli.cpp:62
msgctxt "Cli|"
msgid ""
"Read source text from files. Arguments will be interpreted as file paths."
msgstr "הקראת טקסט המקור מקבצים. הארגומנטים יפוענו כנתיבי קבצים."

#: src/cli.cpp:63
msgctxt "Cli|"
msgid "Add stdin data to source text."
msgstr "הוספת נתוני קלט שורת פקודות (stdin) לטקסט המקור."

#: src/cli.cpp:65
#, qt-format
msgctxt "Cli|"
msgid "Do not print any text when using --%1 or --%2."
msgstr "לא להציג טקסט בעת שימוש ב־‎--%1 או ב‏־‎--%2."

#: src/cli.cpp:66
msgctxt "Cli|"
msgid "Print only translations."
msgstr "הצגת התרגומים בלבד."

#: src/cli.cpp:67
msgctxt "Cli|"
msgid "Print output formatted as JSON."
msgstr "הצגת הפלט בסגנון JSON."

#: src/cli.cpp:70
msgctxt "Cli|"
msgid ""
"Application that allows to translate and speak text using various providers"
msgstr "יישום שמאפשר לתרגם ולהקריא טקסט בעזרת מגוון ספקים"

